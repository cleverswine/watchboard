@using Microsoft.AspNetCore.Components.Sections
@inherits LayoutComponentBase

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
    <title>Watch Board</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link href="/lib/bootstrap.min.css" rel="stylesheet"/>
    <link href="/lib/bootstrap-icons.min.css" rel="stylesheet"/>
    @* <link href="/css/theme.css" rel="stylesheet" type="text/css"/> *@
    <link href="/css/app.css" rel="stylesheet" type="text/css"/>
</head>

<body>


<nav class="navbar navbar-dark navbar-expand-sm">
    <div class="container-fluid mx-4">
        <SectionOutlet SectionName="nav-title"/>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarTogglerDemo02"
                aria-controls="navbarTogglerDemo02" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse d-sm-flex justify-content-end" id="navbarTogglerDemo02">
            <ul class="navbar-nav mb-2 mb-lg-0">
                <SectionOutlet SectionName="nav-end"/>
            </ul>
        </div>
    </div>
</nav>

@Body

<footer class="footer">
    <div class="container py-4 text-center">
        <a class="text-muted text-decoration-none" href="/">Watch Board &copy; @DateTime.Now.Year</a>
        <span class="text-muted px-2"> | </span>
        <a class="text-muted" href="/settings"><i class="bi bi-gear"></i></a>
        <span class="text-muted px-2"> | </span>
        <a class="text-muted" target="_blank" href="https://github.com/cleverswine/watchboard"><i class="bi bi-github"></i></a>
    </div>
</footer>

<script src="/lib/Sortable.min.js"></script>
<script src="/lib/bootstrap.bundle.min.js"></script>
<script src="/lib/htmx.min.js"></script>
<script src="/js/app.js"></script>

</body>
</html>