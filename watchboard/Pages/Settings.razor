@using Microsoft.AspNetCore.Components.Sections
@using WatchBoard.Pages.Shared
@layout _Layout

<SectionContent SectionName="nav-title">
    <button type="button" class="navbar-brand nav-link">
        <i class="bi bi-gear"></i> Settings
    </button>
</SectionContent>

<SectionContent SectionName="nav-end">
    <li class="nav-item">
        <a class="nav-link me-3" href="/">
            <i class="bi bi-chevron-left"></i> Home
        </a>
    </li>
</SectionContent>

<div class="container-fluid px-md-4">
    <nav class="navbar navbar-expand-sm ">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link settings-nav-link active" href="#"
                           hx-get="/app/settings/system-logs"
                           hx-target="#settings-container"
                           hx-swap="innerHTML">System Logs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link settings-nav-link" href="#"
                           hx-get="/app/settings/data-refresh"
                           hx-target="#settings-container"
                           hx-swap="innerHTML">Data Refresh</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link disabled" aria-disabled="true">Manage Boards</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link disabled" aria-disabled="true">Manage Lists</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="settings-container"
         hx-get="/app/settings/system-logs"
         hx-trigger="load"
         hx-swap="innerHTML">
    </div>
</div>

<!-- Bootstrap Modal for ItemDetails -->
<div id="modals-here" class="modal modal-blur fade" style="display: none" aria-hidden="false" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">XXX</div>
    </div>
</div>

<script>
    document.addEventListener('htmx:afterSwap', function (event) {
        if (event.detail.target.id === 'settings-container' && event.detail.requestConfig.elt.classList.contains('settings-nav-link')) {
            document.querySelectorAll('.settings-nav-link').forEach(link => link.classList.remove('active'));
            if (event.detail.requestConfig && event.detail.requestConfig.elt) {
                event.detail.requestConfig.elt.classList.add('active');
            }
        }
    });
</script>

