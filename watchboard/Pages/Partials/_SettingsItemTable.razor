@using WatchBoard.Database.Entities

<div class="card border-dark-subtle mb-3">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                Data Refresh
                <span class="badge rounded-pill text-bg-secondary bg-opacity-50 text-white-50">
                    @Items.Count items
                </span>
            </div>

            <div class="d-flex align-items-center gap-2">
                @* <button type="button" class="btn btn-sm rounded-pill btn-outline-secondary" id="refresh-selected-btn" *@
                @*         onclick="refreshSelectedItems()" disabled> *@
                @*     <i class="bi bi-arrow-clockwise"></i> Refresh Selected *@
                @* </button> *@
                <button type="button" class="btn btn btn-sm rounded-pill btn-outline-secondary"
                        data-action="refresh"
                        id="refresh-selected-btn" onclick="applyToSelected(this)" disabled>
                    <i class="bi bi-arrow-clockwise"></i> Refresh Selected
                </button>
                <div class="dropdown">
                    <button class="btn btn btn-sm rounded-pill btn-outline-secondary" type="button"
                            data-bs-toggle="dropdown"
                            id="move-selected-btn"
                            aria-expanded="false" disabled>
                        <i class="bi bi-folder-plus"></i> Move Selected
                    </button>
                    <ul class="dropdown-menu">
                        @foreach (var b in Boards)
                        {
                            foreach (var l in b.Lists)
                            {
                                <li>
                                    <button class="dropdown-item" data-action="move" data-list="@l.Id" onclick="applyToSelected(this)">
                                        <span><i class="bi bi-arrow-right me-2"></i> @b.Name - @l.Name</span>
                                    </button>
                                </li>
                            }
                        }
                    </ul>
                </div>
                <button type="button" class="btn btn btn-sm rounded-pill btn-outline-secondary" data-action="delete"
                        id="delete-selected-btn" onclick="applyToSelected(this)" disabled>
                    <i class="bi bi-trash"></i> Delete Selected
                </button>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0" id="all-items-table">
                <thead class="table-dark">
                <tr>
                    <th style="width: 40px;">
                        <input type="checkbox" class="form-check-input" id="select-all-checkbox"
                               onchange="toggleSelectAll(this)">
                    </th>
                    <th class="sortable" data-sort="board" onclick="sortTable('board')">
                        Board <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="sortable" data-sort="list" onclick="sortTable('list')">
                        List <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="sortable" data-sort="name" onclick="sortTable('name')">
                        Name <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="sortable" data-sort="notes" onclick="sortTable('notes')">
                        Notes <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="sortable" data-sort="lastUpdated" onclick="sortTable('lastUpdated')">
                        Last Updated <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                </tr>
                </thead>
                <tbody id="all-items-tbody">
                @foreach (var item in Items)
                {
                    <_SettingsItemRow ItemModel="item" BoardName="@GetBoardName(item)"
                                      ListName="@GetListName(item)"></_SettingsItemRow>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .sortable {
        cursor: pointer;
        user-select: none;
    }

    .sortable:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    .sort-icon {
        font-size: 0.75em;
        opacity: 0.5;
    }

    .sort-asc .sort-icon::before {
        content: "\F282"; /* bi-chevron-up */
    }

    .sort-desc .sort-icon::before {
        content: "\F285"; /* bi-chevron-down */
    }

    #all-items-table th, #all-items-table td {
        vertical-align: middle;
    }

    .fade-out {
        opacity: 0;
        transition: opacity 0.5s ease-out;
    }
</style>

<script>
    let currentSort = {column: null, direction: 'asc'};

    function toggleSelectAll(checkbox) {
        const checkboxes = document.querySelectorAll('#all-items-tbody input[type="checkbox"]');
        checkboxes.forEach(cb => cb.checked = checkbox.checked);
        updateActionButtonsState();
    }

    function updateActionButtonsState() {
        const checkedCount = document.querySelectorAll('#all-items-tbody input[type="checkbox"]:checked').length;
        const refreshBtn = document.getElementById('refresh-selected-btn');
        refreshBtn.disabled = checkedCount === 0;
        const deleteBtn = document.getElementById('delete-selected-btn');
        deleteBtn.disabled = checkedCount === 0;
        const moveBtn = document.getElementById('move-selected-btn');
        moveBtn.disabled = checkedCount === 0;
    }

    function updateSelectAllState() {
        const allCheckboxes = document.querySelectorAll('#all-items-tbody input[type="checkbox"]');
        const checkedCheckboxes = document.querySelectorAll('#all-items-tbody input[type="checkbox"]:checked');
        const selectAllCheckbox = document.getElementById('select-all-checkbox');
        selectAllCheckbox.checked = allCheckboxes.length === checkedCheckboxes.length;
        selectAllCheckbox.indeterminate = checkedCheckboxes.length > 0 && checkedCheckboxes.length < allCheckboxes.length;
    }

    function sortTable(column) {
        const tbody = document.getElementById('all-items-tbody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const headers = document.querySelectorAll('#all-items-table thead th.sortable');

        // Toggle direction if same column, otherwise default to asc
        if (currentSort.column === column) {
            currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
        } else {
            currentSort.column = column;
            currentSort.direction = 'asc';
        }

        // Update header styles
        headers.forEach(th => {
            th.classList.remove('sort-asc', 'sort-desc');
            if (th.dataset.sort === column) {
                th.classList.add(currentSort.direction === 'asc' ? 'sort-asc' : 'sort-desc');
            }
        });

        // Sort rows
        rows.sort((a, b) => {
            const aVal = a.dataset[column] || '';
            const bVal = b.dataset[column] || '';

            // Try numeric sort first
            const aNum = parseFloat(aVal);
            const bNum = parseFloat(bVal);
            if (!isNaN(aNum) && !isNaN(bNum)) {
                return currentSort.direction === 'asc' ? aNum - bNum : bNum - aNum;
            }

            // Fall back to string comparison
            const comparison = aVal.localeCompare(bVal, undefined, {numeric: true, sensitivity: 'base'});
            return currentSort.direction === 'asc' ? comparison : -comparison;
        });

        // Re-append rows in sorted order
        rows.forEach(row => tbody.appendChild(row));
    }

    async function applyToSelected(button) {
        button.blur();
        const action = button.dataset.action;
        const checkboxes = document.querySelectorAll('#all-items-tbody input[type="checkbox"]:checked');
        const itemIds = Array.from(checkboxes).map(cb => cb.value);

        for (const itemId of itemIds) {
            const row = document.getElementById(`row-${itemId}`);
            if (!row) continue;

            if (action === 'refresh') {
                await htmx.ajax('PUT', `/app/items/${itemId}/refresh?view=row`, {
                    target: row,
                    swap: 'outerHTML'
                });
            } else if (action === 'delete') {
                row.classList.add('fade-out');
                await htmx.ajax('DELETE', `/app/items/${itemId}`, {
                    target: row,
                    swap: 'delete swap:500ms'
                });
            } else if (action === 'move') {
                const listId = button.dataset.list;
                await htmx.ajax('PUT', `/app/items/${itemId}/move/lists/${listId}?view=row`, {
                    target: row,
                    swap: 'outerHTML'
                });
            }
        }
    }
</script>

@code {

    [Parameter]
    public List<Item> Items { get; set; } = [];

    [Parameter]
    public List<Board> Boards { get; set; } = [];

    private string GetBoardName(Item item)
    {
        var list = Boards.SelectMany(b => b.Lists).FirstOrDefault(l => l.Id == item.ListId);
        if (list == null) return "Unknown";
        return Boards.FirstOrDefault(b => b.Id == list.BoardId)?.Name ?? "Unknown";
    }

    private string GetListName(Item item)
    {
        var list = Boards.SelectMany(b => b.Lists).FirstOrDefault(l => l.Id == item.ListId);
        return list?.Name ?? "Unknown";
    }

}
