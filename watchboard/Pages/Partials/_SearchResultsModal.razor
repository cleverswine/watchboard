@using Humanizer
@using WatchBoard.Database.Entities

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong>
        <div class="mt-1"><pre class="mb-0">@ErrorMessage</pre></div>
    </div>
}
else if (Items.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No results found.
    </div>
}
else
{
    @foreach (var itemModel in Items)
    {
        <div class="d-flex gap-2 justify-content-between align-items-start mb-3">
            <div class="d-flex gap-3 align-items-start">
                <img src="@(itemModel.PosterUrl)" width="48" height="72" class="rounded" alt="@itemModel.Name">
                <div class="py-0">
                    <span class="fw-bold">@itemModel.Name</span>
                    <div class="text-muted" style="font-size: 0.9em">
                        @(itemModel.Type == ItemType.Tv ? "TV Series" : "Movie") • @itemModel.ReleaseDates()
                        @if (itemModel.OriginalLanguage?.ToUpper() != "EN")
                        {
                            <span class="ms-2">[@(itemModel.OriginalLanguage?.ToUpper() ?? "??")]</span>
                        }
                    </div>
                    <div class="text-muted" style="font-size: 0.8em">
                        @itemModel.Overview.Truncate(120)
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-primary"
                    hx-indicator="#add-indicator-@(itemModel.TmdbId)"
                    hx-swap="outerHTML"
                    hx-post="/app/items/@(itemModel.TmdbId)?type=@(itemModel.Type.ToString().ToLower())">
                <span>Add</span><span class="htmx-indicator" id="add-indicator-@(itemModel.TmdbId)">ing...</span>
            </button>
        </div>
    }
}

@code
{
    [Parameter]
    public List<Item> Items { get; set; } = [];

    [Parameter]
    public List<List> Lists { get; set; } = [];

    [Parameter]
    public string? ErrorMessage { get; set; }
}
