@using WatchBoard.Database.Entities
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <strong>Error:</strong>
        <div class="mt-1"><pre class="mb-0">@ErrorMessage</pre></div>
    </div>
}
else if (Items == null || Items.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        No results found.
    </div>
}
else
{
    @foreach (var itemModel in Items)
    {
        <div class="card mb-3 bg-body-tertiary">
            <div class="row g-0">
                <div class="col-md-4">
                    <img src="@(itemModel.PosterUrl)" width="92" height="138" class="img-fluid rounded-start" alt="@itemModel.Name">
                </div>
                <div class="col-md-8">
                    <div class="card-body p-2">
                        <h6 class="card-title">
                            <a href="#" onclick="document.getElementById('searchInput').value = '';" 
                               class="text-body-emphasis text-decoration-none stretched-link" 
                               hx-indicator="#add-indicator-@(itemModel.TmdbId)"
                               hx-swap="innerHTML"
                               hx-target="#item-added-@(itemModel.TmdbId)"
                               hx-post="/app/items/@(itemModel.TmdbId)?type=@(itemModel.Type.ToString().ToLower())">
                                @itemModel.Name
                            </a>
                        </h6>
                        <p class="card-text">
                            <i class="bi @(itemModel.Type == ItemType.Movie ? "bi-film" : "bi-tv")"></i> @itemModel.ReleaseDates()
                            @if (itemModel.OriginalLanguage?.ToUpper() != "EN")
                            {
                                <span class="ms-2">[@(itemModel.OriginalLanguage?.ToUpper() ?? "??")]</span>
                            }
                            <div class="htmx-indicator text-secondary-emphasis" id="add-indicator-@(itemModel.TmdbId)" role="status">
                                <span class="spinner-border spinner-border-sm me-1"></span> adding...
                            </div>
                            <div id="item-added-@(itemModel.TmdbId)" class="text-success fw-bold">
                                
                            </div>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code
{
    [Parameter]
    public List<Item> Items { get; set; } = [];

    [Parameter]
    public List<List> Lists { get; set; } = [];

    [Parameter]
    public string? ErrorMessage { get; set; }
}
