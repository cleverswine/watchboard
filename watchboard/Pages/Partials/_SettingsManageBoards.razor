@using WatchBoard.Database.Entities

<div class="card border-dark-subtle mb-3">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                Manage Boards
                <span class="badge rounded-pill text-bg-secondary bg-opacity-50 text-white-50" id="boards-count-badge">
                    @Boards.Count boards
                </span>
            </div>
            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="showAddBoardModal()">
                <i class="bi bi-plus-lg"></i> Add Board
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0" id="manage-boards-table">
                <thead class="table-dark">
                <tr>
                    <th style="width: 50px;"></th>
                    <th>Name</th>
                    <th style="width: 100px;">Lists</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
                </thead>
                <tbody id="boards-sortable">
                @foreach (var board in Boards)
                {
                    <_SettingsBoardRow BoardModel="board"></_SettingsBoardRow>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteBoardModal" tabindex="-1" aria-labelledby="deleteBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteBoardModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the board "<span id="deleteBoardName"></span>"?</p>
                <p class="text-danger"><i class="bi bi-exclamation-triangle"></i> This will also delete all lists and items in this board.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBoardBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Add Board Modal -->
<div class="modal fade" id="addBoardModal" tabindex="-1" aria-labelledby="addBoardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addBoardModalLabel">Add New Board</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newBoardName" class="form-label">Board Name</label>
                    <input type="text" class="form-control" id="newBoardName" placeholder="Enter board name"
                           onkeydown="handleAddBoardKeydown(event)">
                </div>
                <p class="text-muted small">
                    <i class="bi bi-info-circle"></i> Default lists (Queue, Watching, Finished) will be created automatically.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmAddBoardBtn">Add Board</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initBoardsSortable();
    });

    // Re-initialize after htmx swaps
    document.body.addEventListener('htmx:afterSwap', function(event) {
        if (event.detail.target.id === 'settings-container') {
            initBoardsSortable();
        }
    });

    function initBoardsSortable() {
        const sortableEl = document.getElementById('boards-sortable');
        if (sortableEl && typeof Sortable !== 'undefined') {
            new Sortable(sortableEl, {
                animation: 150,
                handle: '.drag-handle',
                ghostClass: 'sortable-ghost',
                onEnd: function(evt) {
                    const boardIds = Array.from(sortableEl.querySelectorAll('tr[data-board-id]'))
                        .map(row => row.dataset.boardId);

                    fetch('/app/settings/boards/reorder', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(boardIds)
                    });
                }
            });
        }
    }

    function startEditBoard(boardId, currentName) {
        const nameCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-display`);
        const editCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-edit`);
        const input = editCell.querySelector('input');

        nameCell.classList.add('d-none');
        editCell.classList.remove('d-none');
        input.value = currentName;
        input.focus();
        input.select();
    }

    function cancelEditBoard(boardId) {
        const nameCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-display`);
        const editCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-edit`);

        nameCell.classList.remove('d-none');
        editCell.classList.add('d-none');
    }

    function saveEditBoard(boardId) {
        const editCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-edit`);
        const input = editCell.querySelector('input');
        const newName = input.value.trim();

        if (!newName) {
            cancelEditBoard(boardId);
            return;
        }

        fetch(`/app/settings/boards/${boardId}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ name: newName })
        })
        .then(response => {
            if (response.ok) {
                const nameCell = document.querySelector(`tr[data-board-id="${boardId}"] .board-name-display`);
                nameCell.textContent = newName;
                cancelEditBoard(boardId);
            }
        });
    }

    function handleEditKeydown(event, boardId) {
        if (event.key === 'Enter') {
            event.preventDefault();
            saveEditBoard(boardId);
        } else if (event.key === 'Escape') {
            cancelEditBoard(boardId);
        }
    }

    let boardToDelete = null;

    function showDeleteBoardModal(boardId, boardName) {
        boardToDelete = boardId;
        document.getElementById('deleteBoardName').textContent = boardName;
        const modal = new bootstrap.Modal(document.getElementById('deleteBoardModal'));
        modal.show();
    }

    document.addEventListener('DOMContentLoaded', function() {
        const confirmBtn = document.getElementById('confirmDeleteBoardBtn');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', function() {
                if (boardToDelete) {
                    fetch(`/app/settings/boards/${boardToDelete}`, {
                        method: 'DELETE'
                    })
                    .then(response => {
                        if (response.ok) {
                            const row = document.querySelector(`tr[data-board-id="${boardToDelete}"]`);
                            if (row) row.remove();

                            // Update board count
                            updateBoardCount(-1);
                        }
                        bootstrap.Modal.getInstance(document.getElementById('deleteBoardModal')).hide();
                        boardToDelete = null;
                    });
                }
            });
        }

        // Add Board button click handler
        const addBoardBtn = document.getElementById('confirmAddBoardBtn');
        if (addBoardBtn) {
            addBoardBtn.addEventListener('click', function() {
                createNewBoard();
            });
        }
    });

    function showAddBoardModal() {
        document.getElementById('newBoardName').value = '';
        const modal = new bootstrap.Modal(document.getElementById('addBoardModal'));
        modal.show();
        setTimeout(() => document.getElementById('newBoardName').focus(), 200);
    }

    function handleAddBoardKeydown(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            createNewBoard();
        } else if (event.key === 'Escape') {
            bootstrap.Modal.getInstance(document.getElementById('addBoardModal')).hide();
        }
    }

    function createNewBoard() {
        const input = document.getElementById('newBoardName');
        const boardName = input.value.trim();

        if (!boardName) {
            input.classList.add('is-invalid');
            return;
        }

        input.classList.remove('is-invalid');

        fetch('/app/settings/boards', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ name: boardName })
        })
        .then(response => response.text())
        .then(html => {
            const tbody = document.getElementById('boards-sortable');
            if (tbody) {
                tbody.insertAdjacentHTML('beforeend', html);
            }

            // Update board count
            updateBoardCount(1);

            // Close modal
            bootstrap.Modal.getInstance(document.getElementById('addBoardModal')).hide();
            input.value = '';
        });
    }

    function updateBoardCount(delta) {
        const countBadge = document.getElementById('boards-count-badge');
        if (countBadge) {
            const currentCount = parseInt(countBadge.textContent) || 0;
            const newCount = currentCount + delta;
            countBadge.textContent = `${newCount} board${newCount !== 1 ? 's' : ''}`;
        }
    }
</script>

<style>
    .drag-handle {
        cursor: grab;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .sortable-ghost {
        opacity: 0.4;
        background-color: #444;
    }

    #boards-sortable tr {
        transition: background-color 0.2s;
    }
</style>

@code {
    [Parameter]
    public List<Board> Boards { get; set; } = [];
}
