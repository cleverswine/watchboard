@using WatchBoard.Database.Entities

<div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Add TV Show or Movie</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <form hx-post="/app/search" hx-target="#searchResultsModal" hx-indicator="#search-indicator">
                <div class="d-flex flex-row gap-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="SearchType" id="searchTypeTv"
                               value="@ItemType.Tv" checked>
                        <label class="form-check-label" for="searchTypeTv">
                            TV Shows
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="SearchType" id="searchTypeMovies"
                               value="@ItemType.Movie">
                        <label class="form-check-label" for="searchTypeMovies">
                            Movies
                        </label>
                    </div>
                </div>
                <div class="d-flex flex-row mt-3 mb-3">
                    <input id="searchInput" class="form-control" type="search" name="SearchName"
                           placeholder="Search"
                           aria-label="Search">
                    <button class="btn btn-outline-success" type="submit" hx-disabled-elt="this">
                        Search
                    </button>
                </div>
            </form>
            <div class="htmx-indicator ps-3" id="search-indicator" role="status">
                <span class="spinner-border spinner-border-sm"></span> searching...
            </div>
            <div id="searchResultsModal">

            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="btn btn-primary">Save changes</button>
        </div>
    </div>
</div>

