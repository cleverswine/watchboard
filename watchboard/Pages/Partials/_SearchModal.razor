@using WatchBoard.Database.Entities

<div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
        <div class="modal-header">
            <form class="w-100" hx-post="/app/search" hx-target="#searchResultsModal" hx-indicator="#search-indicator">
                <div class="d-flex justify-content-between gap-3">
                    <input id="searchInput" class="form-control w-75" type="search" name="SearchName"
                           placeholder="Search for TV shows or movies..."
                           aria-label="Search" autofocus="autofocus">
                    <div>
                        <input type="radio" value="@ItemType.Tv" class="btn-check" name="SearchType" id="option2"
                               autocomplete="off" checked>
                        <label class="btn btn-outline-secondary rounded-pill" for="option2"><i class="bi bi-tv me-0"></i></label>
                        <input type="radio" value="@ItemType.Movie" class="btn-check" name="SearchType" id="option1"
                               autocomplete="off">
                        <label class="btn btn-outline-secondary rounded-pill" for="option1"><i class="bi bi-film me-0"></i></label>
                    </div>
                </div>
            </form>
        </div>
        <div class="modal-body">
            <div class="htmx-indicator ps-3" id="search-indicator" role="status">
                <span class="spinner-border spinner-border-sm"></span> searching...
            </div>
            <div id="searchResultsModal">
                <p class="text-center text-muted py-5">
                    Enter a search term and press enter to search...
                </p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
    </div>
</div>

