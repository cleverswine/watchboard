@using WatchBoard.Database.Entities

@foreach (var board in Boards)
{
    <div class="card border-dark-subtle mb-3">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    @board.Name
                    <span class="badge rounded-pill text-bg-secondary bg-opacity-50 text-white-50"
                          id="lists-count-badge">
                        @board.Lists.Count lists
                    </span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill" onclick="showAddListModal()">
                    <i class="bi bi-plus-lg"></i> Add List
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                    <tr>
                        <th style="width: 50px;"></th>
                        <th>Name</th>
                        <th style="width: 100px;">Items</th>
                        <th style="width: 100px;">Default</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                    </thead>
                    <tbody class="lists-sortable" data-board-id="@board.Id">
                    @foreach (var list in board.Lists)
                    {
                        <_SettingsListRow ListModel="list" BoardName="@board.Name"></_SettingsListRow>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteListModal" tabindex="-1" aria-labelledby="deleteListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteListModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the list "<span id="deleteListName"></span>"?</p>
                <p class="text-danger"><i class="bi bi-exclamation-triangle"></i> This will also delete all items in this list.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteListBtn">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Add List Modal -->
<div class="modal fade" id="addListModal" tabindex="-1" aria-labelledby="addListModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addListModalLabel">Add New List</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label for="newListBoard" class="form-label">Board</label>
                    <select class="form-select" id="newListBoard">
                        @foreach (var board in Boards)
                        {
                            <option value="@board.Id">@board.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="newListName" class="form-label">List Name</label>
                    <input type="text" class="form-control" id="newListName" placeholder="Enter list name"
                           onkeydown="handleAddListKeydown(event)">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirmAddListBtn">Add List</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initListsSortable();
    });

    document.body.addEventListener('htmx:afterSwap', function(event) {
        if (event.detail.target.id === 'settings-container') {
            initListsSortable();
        }
    });

    function initListsSortable() {
        document.querySelectorAll('.lists-sortable').forEach(sortableEl => {
            if (typeof Sortable !== 'undefined') {
                new Sortable(sortableEl, {
                    animation: 150,
                    handle: '.drag-handle',
                    ghostClass: 'sortable-ghost',
                    onEnd: function() {
                        const boardId = sortableEl.dataset.boardId;
                        const listIds = Array.from(sortableEl.querySelectorAll('tr[data-list-id]'))
                            .map(row => row.dataset.listId);

                        fetch('/app/settings/lists/reorder?boardId=' + boardId, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(listIds)
                        });
                    }
                });
            }
        });
    }

    function startEditList(listId, currentName) {
        const nameCell = document.querySelector('tr[data-list-id="' + listId + '"] .list-name-display');
        const editCell = document.querySelector('tr[data-list-id="' + listId + '"] .list-name-edit');
        const input = editCell.querySelector('input');
        nameCell.classList.add('d-none');
        editCell.classList.remove('d-none');
        input.value = currentName;
        input.focus();
        input.select();
    }

    function cancelEditList(listId) {
        const nameCell = document.querySelector('tr[data-list-id="' + listId + '"] .list-name-display');
        const editCell = document.querySelector('tr[data-list-id="' + listId + '"] .list-name-edit');
        nameCell.classList.remove('d-none');
        editCell.classList.add('d-none');
    }

    function saveEditList(listId) {
        const editCell = document.querySelector('tr[data-list-id="' + listId + '"] .list-name-edit');
        const input = editCell.querySelector('input');
        const newName = input.value.trim();
        if (!newName) { cancelEditList(listId); return; }

        fetch('/app/settings/lists/' + listId, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: newName })
        }).then(response => {
            if (response.ok) {
                document.querySelector('tr[data-list-id="' + listId + '"] .list-name-display').textContent = newName;
                cancelEditList(listId);
            }
        });
    }

    function handleEditListKeydown(event, listId) {
        if (event.key === 'Enter') { event.preventDefault(); saveEditList(listId); }
        else if (event.key === 'Escape') { cancelEditList(listId); }
    }

    function setDefaultList(listId, boardId) {
        fetch('/app/settings/lists/' + listId + '/default', { method: 'PUT' })
        .then(response => {
            if (response.ok) {
                document.querySelectorAll('tbody[data-board-id="' + boardId + '"] .default-badge').forEach(b => b.classList.add('d-none'));
                document.querySelectorAll('tbody[data-board-id="' + boardId + '"] .set-default-btn').forEach(b => b.classList.remove('d-none'));
                const row = document.querySelector('tr[data-list-id="' + listId + '"]');
                if (row) {
                    row.querySelector('.default-badge').classList.remove('d-none');
                    row.querySelector('.set-default-btn').classList.add('d-none');
                }
            }
        });
    }

    let listToDelete = null;

    function showDeleteListModal(listId, listName) {
        listToDelete = listId;
        document.getElementById('deleteListName').textContent = listName;
        new bootstrap.Modal(document.getElementById('deleteListModal')).show();
    }

    document.addEventListener('DOMContentLoaded', function() {
        const confirmBtn = document.getElementById('confirmDeleteListBtn');
        if (confirmBtn) {
            confirmBtn.addEventListener('click', function() {
                if (listToDelete) {
                    fetch('/app/settings/lists/' + listToDelete, { method: 'DELETE' })
                    .then(response => {
                        if (response.ok) {
                            const row = document.querySelector('tr[data-list-id="' + listToDelete + '"]');
                            if (row) row.remove();
                            updateListCount(-1);
                        }
                        bootstrap.Modal.getInstance(document.getElementById('deleteListModal')).hide();
                        listToDelete = null;
                    });
                }
            });
        }
        const addListBtn = document.getElementById('confirmAddListBtn');
        if (addListBtn) { addListBtn.addEventListener('click', createNewList); }
    });

    function showAddListModal() {
        document.getElementById('newListName').value = '';
        new bootstrap.Modal(document.getElementById('addListModal')).show();
        setTimeout(() => document.getElementById('newListName').focus(), 200);
    }

    function handleAddListKeydown(event) {
        if (event.key === 'Enter') { event.preventDefault(); createNewList(); }
        else if (event.key === 'Escape') { bootstrap.Modal.getInstance(document.getElementById('addListModal')).hide(); }
    }

    function createNewList() {
        const boardId = document.getElementById('newListBoard').value;
        const input = document.getElementById('newListName');
        const listName = input.value.trim();
        if (!listName) { input.classList.add('is-invalid'); return; }
        input.classList.remove('is-invalid');

        fetch('/app/settings/lists?boardId=' + boardId, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name: listName })
        })
        .then(response => response.text())
        .then(html => {
            const tbody = document.querySelector('tbody[data-board-id="' + boardId + '"]');
            if (tbody) tbody.insertAdjacentHTML('beforeend', html);
            updateListCount(1);
            bootstrap.Modal.getInstance(document.getElementById('addListModal')).hide();
            input.value = '';
        });
    }

    function updateListCount(delta) {
        const badge = document.getElementById('lists-count-badge');
        if (badge) {
            const count = (parseInt(badge.textContent) || 0) + delta;
            badge.textContent = count + ' list' + (count !== 1 ? 's' : '');
        }
    }
</script>

<style>
    .drag-handle { cursor: grab; }
    .drag-handle:active { cursor: grabbing; }
    .sortable-ghost { opacity: 0.4; background-color: #444; }
    .lists-sortable tr { transition: background-color 0.2s; }
</style>

@code {
    [Parameter]
    public List<Board> Boards { get; set; } = [];
}
